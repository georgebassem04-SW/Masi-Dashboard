# ============================================================
# DASHBOARD SETTINGS — copy this file to ".env.local" and fill it in.
# .env.local is private: never commit it or send it to anyone.
# ============================================================

# Where the data comes from:
#   mock = sample JSON files in mock-data/ (for development)
#   http = the real API (ADMIN_API_BASE_URL below)
DATA_SOURCE=mock

# The API the dashboard talks to (only used when DATA_SOURCE=http).
# Example: https://api.client.com/v1
ADMIN_API_BASE_URL=

# Secret used to sign the staff login cookie. 32+ random characters.
# REQUIRED on the live server. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Address of the client's shop (used for "view on website" links)
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000

# Address where uploaded images can be opened (sample-data mode: this dashboard itself)
MEDIA_PUBLIC_URL=http://localhost:3002

# After "Publish" in Theme & design, the dashboard asks the storefront to refresh.
# Both must match the storefront's settings (its address and its REVALIDATE_SECRET).
STOREFRONT_URL=http://localhost:3000
REVALIDATE_SECRET=

# See REAL orders placed on the storefront (on your computer) in the dashboard's Orders section.
# Status changes are written back, so the customer sees them in "My orders". Sample-data mode only.
STOREFRONT_MOCK_DB=../storefront/.mock-db/db.json
